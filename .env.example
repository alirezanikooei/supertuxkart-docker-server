# Leave empty to use server_config.xml (normal race by default).
# Values: race, time-trial, soccer, free-for-all, capture-the-flag
GAME_MODE=

# Optional bots for supported race modes.
AI_KARTS=0

# Use a local config directory instead of the managed data volume.
# STK_DATA_VOLUME=./stk_config_data

# Use a different image tag or a local build.
# STK_IMAGE=ghcr.io/alirezanikooei/supertuxkart-docker-server:latest
